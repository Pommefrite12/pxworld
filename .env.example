# ──────────────────────────────────────────────────────────────────────────────
# Pixel World — environment variables.  Copy to .env.local (never commit real secrets).
# Anything left empty disables the matching feature with a clear message; nothing is faked.
# ──────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used for canonical URLs, Open Graph, Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (Supabase: Project settings → Database → connection string, use the POOLER string on Vercel)
DATABASE_URL=postgres://pixel:pixel@127.0.0.1:54329/pixelworld
# DATABASE_SSL=false          # default: on for public host names, off for localhost and bare Docker service names (db)
# DATABASE_POOL_MAX=10

# Supabase (Auth + Storage). Leave empty in local development to use DEV_AUTH + local file storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server only — never expose in the browser
SUPABASE_PUBLIC_BUCKET=pixel-world-creations   # create it as a PRIVATE bucket

# Stripe — use TEST keys (sk_test_…) until live payments are explicitly approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false           # true once Stripe Tax is configured in your Stripe account
STRIPE_INVOICE_CREATION=true
# Live keys (sk_live_…) are REFUSED by the code unless this is set. Do not set it before approval.
# PAYMENTS_LIVE_ENABLED=yes-i-have-approval

# Automatic translation of what visitors write (title and description of a parcel): done by Claude on the first view of a parcel, in the 4 languages
# at once, then kept in the database. OFF until a key is given (create one at console.anthropic.com and set a monthly spending limit there).
# What a visitor wrote is sent to Anthropic for this: say so in the privacy policy. Never put the key in the chat or on GitHub.
# ANTHROPIC_API_KEY=
# TRANSLATE_USER_CONTENT=true          # false switches it off without removing the key
# TRANSLATE_MODEL=claude-opus-5-5      # claude-haiku-5-5 is about 40 times cheaper and faster, for texts this short
# TRANSLATE_DAILY_LIMIT=2000           # at most this many parcels translated per rolling day (a ceiling on the bill)
# TRANSLATE_TIMEOUT_MS=20000           # how long a visitor may wait, once per parcel
# ANTHROPIC_BASE_URL=                  # for the tests only (a stand-in server): the production check refuses it

# Vercel Cron → /api/cron/maintenance (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Test the dollar price on a deployed TEST site without a VPN: every visitor is taken for one from this country (ISO code, e.g. US).
# Only honoured while payments are in test mode (a sk_test_ key); remove it when the test is done.
# TEST_COUNTRY=US

# Alerts (optional): an https "incoming webhook" address (Slack, Discord, ntfy…). Payment failures, failed refunds and server errors are
# posted there, besides being written to the log as "[alert] …". Empty = log only.
ALERT_WEBHOOK_URL=
# Salt for hashing IP addresses (rate limiting, report evidence). Set a long random value in production.
RATE_LIMIT_SALT=change-me

# ── Local development only (ignored when NODE_ENV=production) ────────────────
# Sign in without Supabase Auth:
DEV_AUTH=true
NEXT_PUBLIC_DEV_AUTH=true
DEV_AUTH_SECRET=dev-only-secret-change-me
# Simulate Stripe locally (no network, no real payment; refused if STRIPE_SECRET_KEY is set):
STRIPE_MOCK=true
LOCAL_STORAGE_DIR=.data/storage

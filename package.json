{
  "name": "pixel-world",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel World — one planet, one billion pixels, your mark.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:local": "bash scripts/local-db.sh start",
    "db:local:stop": "bash scripts/local-db.sh stop",
    "db:migrate": "node scripts/migrate.mjs",
    "data:world": "node scripts/build-world-data.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "all-the-cities": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "i18n-iso-countries": "^7.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "topojson-server": "^3.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "world-atlas": "^2.0.2"
  }
}
